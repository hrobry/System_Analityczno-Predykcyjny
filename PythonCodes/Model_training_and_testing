##################################################


import numpy as np
import pandas as pd
import joblib

from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler
from sklearn.ensemble import IsolationForest

CSV_PATH = r"C:xxx.csv"  # <- path with training dataset
#CSV_PATH = r"C:xxx.csv"
TIME_COL = "timestamp"
AXES = ["x", "y", "z"]

WINDOW_MINUTES = 1
STEP_MINUTES = 1
MIN_ROWS = 2  # minimal count of samples in window

MODEL_OUT = "xxx.joblib"

FEATURE_NAMES = [f"{c}_{stat}" for c in AXES for stat in ["mean", "std", "min", "max", "last"]]

def window_features_15(w: pd.DataFrame) -> list[float]:
    feats = []
    for c in AXES:
        s = w[c].astype(float)
        feats.extend([
            float(s.mean()),
            float(s.std(ddof=0)),
            float(s.min()),
            float(s.max()),
            float(s.iloc[-1]),
        ])
    return feats

# reading CSV file
df = pd.read_csv(CSV_PATH)
df[TIME_COL] = pd.to_datetime(df[TIME_COL], errors="coerce", utc=True)
df = df.dropna(subset=[TIME_COL])

for c in AXES:
    df[c] = pd.to_numeric(df[c], errors="coerce")

df = df.dropna(subset=AXES).sort_values(TIME_COL).set_index(TIME_COL)

print("Rows:", len(df))
print("Scope:", df.index.min(), "->", df.index.max())


#################################################


# Model training code


#################################################


X_rows = []
freq = f"{STEP_MINUTES}min"

for window_end, _ in df.groupby(pd.Grouper(freq=freq, label="right", closed="right")):
    window_start = window_end - pd.Timedelta(minutes=WINDOW_MINUTES)
    w = df.loc[(df.index > window_start) & (df.index <= window_end)]
    if len(w) < MIN_ROWS:
        continue
    X_rows.append(window_features_15(w))

X = pd.DataFrame(X_rows, columns=FEATURE_NAMES)

print("Okien treningowych:", len(X))
if len(X) == 0:
    raise RuntimeError("Brak okien do treningu. Zmniejsz MIN_ROWS albo daj więcej danych.")

# pipeline: scaler + IsolationForest
pipe = Pipeline(steps=[
    ("scaler", StandardScaler()),
    ("iso", IsolationForest(
        n_estimators=600,
        contamination=0.01,
        random_state=42,
        n_jobs=-1
    ))
])

pipe.fit(X)

# anomaly_score = -score_samples (Higher = worst suspected)
train_scores = -pipe.score_samples(X)

print("\nPercentyle anomaly_score na treningu (podgląd):")
for p in [0, 50, 90, 95, 99, 100]:
    print(f"p{p:>3}: {np.percentile(train_scores, p):.6f}")

joblib.dump(pipe, MODEL_OUT)
print("\nZapisano model:", MODEL_OUT)


