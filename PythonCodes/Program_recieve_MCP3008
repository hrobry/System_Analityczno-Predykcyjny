

#################################################


# Program Rpi to recieve information from sensor MCP3008


#################################################



from datetime import datetime, timezone
import spidev
import time
import psycopg2

# --- MCP3008 setup ---
spi = spidev.SpiDev()
spi.open(0, 0)  # bus 0, device 0 (CE0)
spi.max_speed_hz = 1350000

def read_channel(channel):
    """Odczyt wartości z wybranego kanału MCP3008 (0-7)"""
    if not 0 <= channel <= 7:
        raise ValueError("Channel must be 0-7")
    cmd = [1, (8 + channel) << 4, 0]  # start bit + single-ended + channel
    resp = spi.xfer2(cmd)
    return ((resp[1] & 3) << 8) | resp[2]

def convert_to_voltage(adc_value, vref=3.3):
    """Przeliczenie wartości ADC na napięcie"""
    return (adc_value * vref) / 1023

# --- PostgreSQL connection ---
conn = psycopg2.connect(
    dbname="mcp3008",
    user="monio",
    password="monio",
    host="localhost",
    port="5432"
)
cur = conn.cursor()

# --- Parametry batch ---
BATCH_SIZE = 20      # commit co 20 rekordów (4 kanały = 5 odczytów)
SLEEP_TIME = 0.2     # czas między odczytami
buffer = []

try:
    while True:
        ts = datetime.now(timezone.utc)

        for sensor in range(4):  # odczyt 4 kanałów
            raw = read_channel(sensor)
            voltage = convert_to_voltage(raw)
            buffer.append((ts, sensor, voltage))
            print(f"Sensor {sensor}, Voltage: {voltage:.2f} V")

        # commit, gdy zebrano BATCH_SIZE rekordów
        if len(buffer) >= BATCH_SIZE:
            cur.executemany(
                "INSERT INTO mcp3008_data (ts, sensor, voltage) VALUES (%s, %s, %s)",
                buffer
            )
            conn.commit()
            buffer.clear()
            print("Zapisano batch")

        time.sleep(SLEEP_TIME)

except KeyboardInterrupt:
    print("Koniec pomiarów")

finally:
    # commit wszystkiego, co zostało w bufferze
    if buffer:
        cur.executemany(
            "INSERT INTO mcp3008_data (ts, sensor, voltage) VALUES (%s, %s, %s)",
            buffer
        )
        conn.commit()

    cur.close()
    conn.close()
    spi.close()
